# Lokalny rejestr npm (Verdaccio), proxujący registry.npmjs.org z cache'owaniem
# publikowanych paczek — eliminuje zależność od zewnętrznego rejestru w CI.
registry=http://192.168.1.163/

# Łagodzi niestabilność sieci (np. Docker Desktop na Windows) przy instalacji
# kilkuset pakietów — dłuższy timeout i więcej prób przed porażką.
fetch-timeout=300000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
