# Existing config.env is not overwritten by deploy
IMAGE_TITLE=Hospital Information System
IMAGE_DESCRIPTION=Hospital Information System application images
IMAGE_VENDOR=Hospital Information System
IMAGE_LICENSES=UNLICENSED
IMAGE_SOURCE=https://github.com/RobertNeat/Hospital_Information_System

# === JWT Authorization (his_backend) ===
# HIS_JWT_SECRET - required min. 32 byte secret (too stort = backend will not start)
HIS_JWT_SECRET=change-me-min-32-bytes-change-me-min-32-bytes
# HIS_JWT_TTL - access token lifetime (Spring Duration, e.g. 8h, 30m)
# HIS_JWT_ISSUER - optional JWT issuer (claim iss)
# HIS_LOCKOUT_MAX_ATTEMPTS - maximal 5 tries 
# HIS_LOCKOUT_DURATION - lockout duration
# HIS_CORS_ALLOWED_ORIGINS - allowed origins for CORS (separated by comma, empty = CORS disabled)
# HIS_WS_ALLOWED_ORIGINS - allowed origins for WebSocket (separated by comma, empty = same-origin only, frontend behind one nginx)
# HIS_JWT_TTL=15m
# HIS_JWT_ISSUER=his-backend
# HIS_LOCKOUT_MAX_ATTEMPTS=5
# HIS_LOCKOUT_DURATION=15m
# HIS_CORS_ALLOWED_ORIGINS=
# HIS_WS_ALLOWED_ORIGINS=

# === mTLS secrets (his_backend, e-receipt, e-laboratory, e-imaging) ===
# without specified secrets services wont start (compose will purosefully fail `config` command)
# E_RECEIPT_KEYSTORE_PASSWORD - keystore password for e-receipt (change on server)
# E_RECEIPT_KEYSTORE_PASSWORD - keystore password for e-receipt (change on server)
# E_RECEIPT_KEYSTORE_PASSWORD - keystore password for e-receipt (change on server)
# E_RECEIPT_TRUSTSTORE_PASSWORD - truststore password for e-receipt (change on server)
# E_LABORATORY_KEYSTORE_PASSWORD - keystore password for e-laboratory (change on server)
# E_LABORATORY_TRUSTSTORE_PASSWORD - truststore password for e-laboratory (change on server)
# E-IMAGING_KEYSTORE_PASSWORD - keystore password for e-imaging (change on server)
# E_IMAGING_TRUSTSTORE_PASSWORD - truststore password for e-imaging (change on server) 
# HIS_CERTS_DIR - certificates (*.p12) in ${HIS_CERTS_DIR}/<his_backend|e_receipt|e_laboratory|e_imaging>; default ../.certs
# HIS_FHIR_ALLOWED_CLIENT_CNS - allowed CN of client certificates on /fhir/** (comma separated), 
# --> empty by default (no restrictions = any client certificate trusted by CA is authentication on /fhir/**).
HIS_BACKEND_KEYSTORE_PASSWORD=change-me
HIS_BACKEND_TRUSTSTORE_PASSWORD=change-me
E_RECEIPT_KEYSTORE_PASSWORD=change-me
E_RECEIPT_TRUSTSTORE_PASSWORD=change-me
E_LABORATORY_KEYSTORE_PASSWORD=change-me
E_LABORATORY_TRUSTSTORE_PASSWORD=change-me
E_IMAGING_KEYSTORE_PASSWORD=change-me
E_IMAGING_TRUSTSTORE_PASSWORD=change-me
# HIS_CERTS_DIR=./.certs #certs next to the config.env (./.certs)
# HIS_FHIR_ALLOWED_CLIENT_CNS=e-receipt,e-laboratory,e-imaging

# === Postgre SQL (container:postgres, volume: postgres-data) ===
# HIS_DB_NAME - database name
# HIS_DB_USER - database user
# HIS_DB_PASSWORD - database password (change on server)
# HIS_LIQUIBASE_CONTEXTS - contexts for Liquibase (reference = reference data, reference,mock = + demo data)
HIS_DB_NAME=his
HIS_DB_USER=his
HIS_DB_PASSWORD=his
HIS_LIQUIBASE_CONTEXTS=reference

# === SNOMED CT Terminology (container:snowstorm-lite,volume:snowstorm-lite-data)
# Before import of RF2 lunched container:snowstorm-lite-init (after import launched container:snowstorm-lite)
# import path url: http://192.168.1.162:8080/fhir-admin/load-package
# COMPOSE_PROFILES - (terminology) enables snowstorm-lite container
# HIS_SNOWSTORM_ENABLED - load data from snowstorm (true/false), change to true after snowstorm RF2 import
# HIS_SNOWSTORM_ADMIN_USER - snowstorm admin user
# HIS_SNOWSTORM_ADMIN_PASSWORD - snowstorm admin password (change on server)
COMPOSE_PROFILES=terminology
HIS_SNOWSTORM_ENABLED=false
HIS_SNOWSTORM_ADMIN_USER=admin
HIS_SNOWSTORM_ADMIN_PASSWORD=admin

# === Integration FHIR his_backend <-> e-receipt (prescriptions), e-laboratory (lab tests) and e-imaging (imaging tests)
# By default, mTLS is enabled; client certificate trusted by CA is authentication on /fhir/**.
# Switches: HIS side (sending prescriptions / orders) and e-* side (callback with state change / result).
HIS_ERECEIPT_ENABLED=false
ERECEIPT_HIS_ENABLED=false
HIS_ELAB_ENABLED=false
E_LABORATORY_HIS_ENABLED=false
HIS_EIMG_ENABLED=false
E_IMAGING_HIS_ENABLED=false

# === Optional settings (non set default assumed) ===
# Snowstorm client: timeouts, display languages, max page size
# HIS_SNOWSTORM_CONNECT_TIMEOUT=2s
# HIS_SNOWSTORM_READ_TIMEOUT=5s
# HIS_SNOWSTORM_DISPLAY_LANGUAGE=pl,en
# HIS_SNOWSTORM_MAX_PAGE_SIZE=100
# Client e-receipt <-> his_backend: timeouts (Spring Duration)
# HIS_ERECEIPT_CONNECT_TIMEOUT=1s
# HIS_ERECEIPT_READ_TIMEOUT=3s
# ERECEIPT_HIS_CONNECT_TIMEOUT=1s
# ERECEIPT_HIS_READ_TIMEOUT=3s
# Client e-laboratory <-> his_backend: timeouts (Spring Duration)
# HIS_ELAB_CONNECT_TIMEOUT=1s
# HIS_ELAB_READ_TIMEOUT=3s
# E_LABORATORY_HIS_CONNECT_TIMEOUT=1s
# E_LABORATORY_HIS_READ_TIMEOUT=3s
# Client e-imaging <-> his_backend: timeouts (Spring Duration)
# HIS_EIMG_CONNECT_TIMEOUT=1s
# HIS_EIMG_READ_TIMEOUT=3s
# E_IMAGING_HIS_CONNECT_TIMEOUT=1s
# E_IMAGING_HIS_READ_TIMEOUT=3s