IMAGE_TITLE=Hospital Information System
IMAGE_DESCRIPTION=Hospital Information System application images
IMAGE_VENDOR=Hospital Information System
IMAGE_LICENSES=UNLICENSED
IMAGE_SOURCE=https://github.com/RobertNeat/Hospital_Information_System

# Baza danych PostgreSQL (kontener `postgres` w deploy/compose.yml).
# Na serwerze ZMIENIĆ HIS_DB_PASSWORD. Istniejący config.env nie jest
# nadpisywany przez deploy - nowe zmienne dopisać tam ręcznie.
HIS_DB_NAME=his
HIS_DB_USER=his
HIS_DB_PASSWORD=his
# Konteksty Liquibase: reference = dane referencyjne, reference,mock = + dane demo
HIS_LIQUIBASE_CONTEXTS=reference

# Terminologia SNOMED CT (Snowstorm Lite, profil compose `terminology`).
# Domyślnie wyłączona. Aby uruchomić usługę, dopisać na serwerze:
#   COMPOSE_PROFILES=terminology
# (skrypt deploy nie przekazuje --profile; Compose czyta COMPOSE_PROFILES z config.env).
# Po imporcie RF2 (zob. production_deployment.md) ustawić HIS_SNOWSTORM_ENABLED=true.
HIS_SNOWSTORM_ENABLED=false
HIS_SNOWSTORM_ADMIN_USER=admin
# Na serwerze ZMIENIĆ.
HIS_SNOWSTORM_ADMIN_PASSWORD=admin

# Uwierzytelnianie JWT (backend). WYMAGANE: klucz HS256, min. 32 bajty (np. `openssl rand -base64 48`).
# Brak lub zbyt krótki klucz = backend nie wystartuje. Na serwerze dopisać ręcznie do config.env
# i NIE commitować prawdziwej wartości.
HIS_JWT_SECRET=change-me-min-32-bytes-change-me-min-32-bytes
# Czas życia tokenu dostępu (format Spring Duration, np. 8h, 30m)
HIS_JWT_TTL=8h

# Integracja FHIR his_backend <-> e-receipt (recepty). Klucz usługowy (nagłówek X-Service-Key) autoryzuje wywołania
# e-receipt -> his_backend na /fhir/**; pusty = odrzucane. Na serwerze ustawić własną wartość (docelowo mTLS).
# Przełączniki: strona HIS (wysyłanie recept) i strona e-receipt (wywołanie zwrotne ze zmianą stanu).
HIS_FHIR_SERVICE_KEY=change-me-fhir-service-key
HIS_ERECEIPT_ENABLED=false
ERECEIPT_HIS_ENABLED=false

# Opcjonalne (wartości poniżej = domyślne w compose i application.properties; można pominąć).
# Wystawca (claim iss) tokenu JWT
#HIS_JWT_ISSUER=his-backend
# Blokada konta po kolejnych nieudanych logowaniach: liczba prób i czas blokady (Spring Duration)
#HIS_LOCKOUT_MAX_ATTEMPTS=5
#HIS_LOCKOUT_DURATION=15m
# Dozwolone origin (po przecinku). Puste = CORS wyłączony, WebSocket tylko same-origin (frontend za jednym nginx)
#HIS_CORS_ALLOWED_ORIGINS=
#HIS_WS_ALLOWED_ORIGINS=
# Klient Snowstorm: timeouty, języki wyświetlania, maksymalny rozmiar strony
#HIS_SNOWSTORM_CONNECT_TIMEOUT=2s
#HIS_SNOWSTORM_READ_TIMEOUT=5s
#HIS_SNOWSTORM_DISPLAY_LANGUAGE=pl,en
#HIS_SNOWSTORM_MAX_PAGE_SIZE=100
# Klient e-receipt w his_backend / klient his_backend w e-receipt: timeouty (Spring Duration)
#HIS_ERECEIPT_CONNECT_TIMEOUT=1s
#HIS_ERECEIPT_READ_TIMEOUT=3s
#ERECEIPT_HIS_CONNECT_TIMEOUT=1s
#ERECEIPT_HIS_READ_TIMEOUT=3s
