# Szablon lokalnych wartości stosu (BEZ sekretów produkcyjnych - to jawne wartości deweloperskie).
# Użycie: cp deploy/local.env.example deploy/local.env, potem:
#   docker compose -f deploy/compose.yml -f deploy/compose.dev.yml --env-file deploy/local.env up -d --build
REGISTRY=local
IMAGE_TAG=dev

HIS_DB_NAME=his
HIS_DB_USER=his
HIS_DB_PASSWORD=his
HIS_LIQUIBASE_CONTEXTS=reference,mock

# Jawny klucz deweloperski (>= 32 znaków). NIE używać poza lokalnym dev.
HIS_JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-0123456789
HIS_JWT_TTL=15m

# Snowstorm Lite: profil `terminology`; po imporcie RF2 ustawić true.
HIS_SNOWSTORM_ENABLED=false
HIS_SNOWSTORM_ADMIN_USER=admin
HIS_SNOWSTORM_ADMIN_PASSWORD=admin

# Integracja FHIR his_backend <-> e-receipt, e-laboratory, e-imaging (mTLS domyslnie wlaczony).
HIS_ERECEIPT_ENABLED=true
ERECEIPT_HIS_ENABLED=true
HIS_ELAB_ENABLED=true
E_LABORATORY_HIS_ENABLED=true
HIS_EIMG_ENABLED=true
E_IMAGING_HIS_ENABLED=true

# mTLS: certyfikaty z .certs (poza repo; skrypt scripts/gen-certs.sh tworzy katalog z haslami w passwords.env).
# Katalog z podkatalogami his_backend, e_receipt, e_laboratory, e_imaging (sciezka wzgledem deploy/ lub absolutna).
#HIS_CERTS_DIR=../.certs
# Hasla per usluga (wartosci z .certs/passwords.env; NIE commitowac i nie kopiowac do repo).
HIS_BACKEND_KEYSTORE_PASSWORD=change-me
HIS_BACKEND_TRUSTSTORE_PASSWORD=change-me
E_RECEIPT_KEYSTORE_PASSWORD=change-me
E_RECEIPT_TRUSTSTORE_PASSWORD=change-me
E_LABORATORY_KEYSTORE_PASSWORD=change-me
E_LABORATORY_TRUSTSTORE_PASSWORD=change-me
E_IMAGING_KEYSTORE_PASSWORD=change-me
E_IMAGING_TRUSTSTORE_PASSWORD=change-me
