# Szablon lokalnych wartości stosu (BEZ sekretów produkcyjnych - to jawne wartości deweloperskie).
# Użycie: cp deploy/local.env.example deploy/local.env, potem:
#   docker compose -f deploy/compose.yml -f deploy/compose.dev.yml --env-file deploy/local.env up -d --build
REGISTRY=local
IMAGE_TAG=dev

HIS_DB_NAME=his
HIS_DB_USER=his
HIS_DB_PASSWORD=his
HIS_LIQUIBASE_CONTEXTS=reference,mock

# Jawny klucz deweloperski (>= 32 znaków). NIE używać poza lokalnym dev.
HIS_JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-0123456789
HIS_JWT_TTL=8h

# Snowstorm Lite: profil `terminology`; po imporcie RF2 ustawić true.
HIS_SNOWSTORM_ENABLED=false
HIS_SNOWSTORM_ADMIN_USER=admin
HIS_SNOWSTORM_ADMIN_PASSWORD=admin

# Integracja FHIR his_backend <-> e-receipt, e-laboratory, e-imaging (jawny klucz deweloperski; na produkcji własny, docelowo mTLS).
HIS_FHIR_SERVICE_KEY=dev-only-fhir-service-key
HIS_ERECEIPT_ENABLED=true
ERECEIPT_HIS_ENABLED=true
HIS_ELAB_ENABLED=true
E_LABORATORY_HIS_ENABLED=true
HIS_EIMG_ENABLED=true
E_IMAGING_HIS_ENABLED=true
